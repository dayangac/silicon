#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1053d0bf0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1053d52e0 .scope module, "signed_demo" "signed_demo" 3 2;
 .timescale 0 0;
v0x1053d0d70_0 .var/s "a", 7 0;
v0x1053d5460_0 .var "u", 7 0;
v0x1053d5500_0 .var "uw", 15 0;
v0x1053d55a0_0 .var/s "w", 15 0;
    .scope S_0x1053d52e0;
T_0 ;
    %pushi/vec4 251, 0, 8;
    %store/vec4 v0x1053d0d70_0, 0, 8;
    %pushi/vec4 251, 0, 8;
    %store/vec4 v0x1053d5460_0, 0, 8;
    %end;
    .thread T_0, $init;
    .scope S_0x1053d52e0;
T_1 ;
    %load/vec4 v0x1053d0d70_0;
    %pad/s 16;
    %store/vec4 v0x1053d55a0_0, 0, 16;
    %load/vec4 v0x1053d5460_0;
    %pad/u 16;
    %store/vec4 v0x1053d5500_0, 0, 16;
    %vpi_call/w 3 10 "$display", "a=%0d u=%0d w=%0d uw=%0d", v0x1053d0d70_0, v0x1053d5460_0, v0x1053d55a0_0, v0x1053d5500_0 {0 0 0};
    %load/vec4 v0x1053d0d70_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr/s 4;
    %load/vec4 v0x1053d5460_0;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %vpi_call/w 3 11 "$display", "a>>>1 = %b   u>>>1 = %b", S<1,vec4,s8>, S<0,vec4,u8> {2 0 0};
    %load/vec4 v0x1053d0d70_0;
    %pad/s 32;
    %cmpi/s 0, 0, 32;
    %flag_get/vec4 5;
    %load/vec4 v0x1053d5460_0;
    %pad/u 32;
    %cmpi/u 0, 0, 32;
    %flag_get/vec4 5;
    %vpi_call/w 3 12 "$display", "a < 0 : %b   u < 0 : %b", S<1,vec4,u1>, S<0,vec4,u1> {2 0 0};
    %end;
    .thread T_1;
