:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x104d01570 .scope module, "number_demo" "number_demo" 2 1;
 .timescale 0 0;
v0x104d016f0_0 .var "a", 7 0;
v0x104cfcbe0_0 .var "b", 7 0;
v0x104cfcc80_0 .var "sum8", 7 0;
v0x104d02210_0 .var "sum9", 8 0;
v0x104d022b0_0 .var "w", 15 0;
    .scope S_0x104d01570;
T_0 ;
    %pushi/vec4 165, 0, 8;
    %store/vec4 v0x104d016f0_0, 0, 8;
    %pushi/vec4 107, 0, 8;
    %store/vec4 v0x104cfcbe0_0, 0, 8;
    %load/vec4 v0x104d016f0_0;
    %pad/u 9;
    %load/vec4 v0x104cfcbe0_0;
    %pad/u 9;
    %add;
    %store/vec4 v0x104d02210_0, 0, 9;
    %load/vec4 v0x104d016f0_0;
    %load/vec4 v0x104cfcbe0_0;
    %add;
    %store/vec4 v0x104cfcc80_0, 0, 8;
    %load/vec4 v0x104d016f0_0;
    %load/vec4 v0x104cfcbe0_0;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x104d022b0_0, 0, 16;
    %vpi_call 2 12 "$display", "a=%0d (0x%h, %b)", v0x104d016f0_0, v0x104d016f0_0, v0x104d016f0_0 {0 0 0};
    %vpi_call 2 13 "$display", "a+b 9-bit = %0d (0x%h)", v0x104d02210_0, v0x104d02210_0 {0 0 0};
    %vpi_call 2 14 "$display", "a+b 8-bit = %0d (0x%h)  carry lost", v0x104cfcc80_0, v0x104cfcc80_0 {0 0 0};
    %pushi/vec4 0, 0, 8;
    %load/vec4 v0x104d016f0_0;
    %concat/vec4; draw_concat_vec4
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %load/vec4 v0x104d016f0_0;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %vpi_call 2 15 "$display", "a<<2 = %0d, a>>3 = %0d", S<1,vec4,u16>, S<0,vec4,u8> {2 0 0};
    %vpi_call 2 16 "$display", "{a,b} = 0x%h", v0x104d022b0_0 {0 0 0};
    %vpi_call 2 17 "$display", "a[7] (MSB)=%b a[0] (LSB)=%b a[3:0]=%h", &PV<v0x104d016f0_0, 7, 1>, &PV<v0x104d016f0_0, 0, 1>, &PV<v0x104d016f0_0, 0, 4> {0 0 0};
    %end;
    .thread T_0;
